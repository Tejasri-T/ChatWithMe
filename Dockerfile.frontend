# ── Stage 1: build deps ───────────────────────────────────────────────────────
FROM python:3.11-slim AS builder

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends gcc \
    && rm -rf /var/lib/apt/lists/*

# Only install what the frontend needs
RUN pip install --upgrade pip \
 && pip install --prefix=/install --no-cache-dir \
        "streamlit>=1.38.0" \
        "httpx>=0.27.0"


# ── Stage 2: runtime ──────────────────────────────────────────────────────────
FROM python:3.11-slim AS runtime

WORKDIR /app

COPY --from=builder /install /usr/local

COPY frontend.py .
COPY .streamlit/ ./.streamlit/

RUN useradd -m -u 1001 appuser && chown -R appuser /app
USER appuser

EXPOSE 8501

# BACKEND_URL env var is set in Railway to point at the backend service
CMD ["sh", "-c", "streamlit run frontend.py --server.port ${PORT:-8501} --server.address 0.0.0.0 --server.headless true"]
